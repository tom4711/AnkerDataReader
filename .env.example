# mock | cloud | lan  (default: mock — safe for cloud VMs without home LAN)
DATA_SOURCE=mock

# Poll interval in seconds (default 60; min 15)
POLL_INTERVAL_SECONDS=60

# Anker cloud credentials (required for DATA_SOURCE=cloud; optional enrich for lan)
ANKER_EMAIL=
ANKER_PASSWORD=
ANKER_COUNTRY=DE
# Optional: pin a specific site id from get_site_list
ANKER_SITE_ID=

# Home LAN defaults (only reachable from your local network / VPN)
SOLARBANK_HOST=192.168.178.190
SOLARBANK_PORT=502
SMART_METER_HOST=192.168.178.83
SMART_METER_PORT=502
MODBUS_UNIT_ID=1
