# mock | lan | cloud
# Prefer "lan" on your home network when using Apple Sign-In (no Anker password).
# "cloud" needs ANKER_EMAIL + ANKER_PASSWORD (not Apple Sign-In alone).
DATA_SOURCE=mock

# Poll interval in seconds (default 60; min 15)
POLL_INTERVAL_SECONDS=60

# Anker cloud credentials — only for DATA_SOURCE=cloud (or optional LAN enrich).
# Apple Sign-In accounts typically cannot use this; share the system to a
# secondary email/password Anker account instead.
ANKER_EMAIL=
ANKER_PASSWORD=
ANKER_COUNTRY=DE
# Optional: pin a specific site id from get_site_list
ANKER_SITE_ID=

# Home LAN defaults (only reachable from your local network / VPN)
SOLARBANK_HOST=192.168.178.190
SOLARBANK_PORT=502
SMART_METER_HOST=192.168.178.83
SMART_METER_PORT=502
MODBUS_UNIT_ID=1
